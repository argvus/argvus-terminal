#!/usr/bin/env sh
# Launch the official Kitty terminal with ARGVUS runtime configuration.

set -eu

# Desktop launchers do not source interactive shell startup files. Keep the
# standard Arch executable locations available without replacing a user's PATH.
case ":${PATH:-}:" in
  *:/usr/bin:*) ;;
  *) PATH="${PATH:+$PATH:}/usr/bin" ;;
esac
export PATH

SYSTEM_ROOT="${ARGVUS_TERMINAL_SYSTEM_CONFIG:-/usr/share/argvus/terminal}"
DEFAULT_THEME="argvus-dark-aether"
DEFAULT_ACCENT="#3590bd"

ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/session/sh/bootstrap.sh}"
if [ -r "$ARGVUS_BOOTSTRAP" ]; then
  # shellcheck disable=SC1090,SC1091
  . "$ARGVUS_BOOTSTRAP"
else
  : "${HOME:?HOME is not set}"
  ARGVUS_CONFIG_HOME="${ARGVUS_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}"
  ARGVUS_CACHE_HOME="${ARGVUS_CACHE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/argvus}"
  paths_cache() { printf '%s\n' "${ARGVUS_CACHE_HOME}/${1}"; }
fi

# shellcheck disable=SC1091
. /usr/share/argvus/lib/i18n.sh

usage() {
  printf '%s\n' "$(argvus_tr terminal usage)"
}

die() {
  printf 'argvus-terminal: %s\n' "$*" >&2
  exit 1
}

read_first_line() {
  _file="$1"
  _fallback="$2"
  if [ -s "$_file" ]; then
    sed -n '1{s/\r$//;s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$_file"
  else
    printf '%s\n' "$_fallback"
  fi
}

read_active_theme() {
  read_first_line "${ARGVUS_CONFIG_HOME}/argvus/.active-theme" "$DEFAULT_THEME"
}

transparency_enabled() {
  _state="$(read_first_line "${ARGVUS_CONFIG_HOME}/argvus/state/transparency" "")"
  if [ -z "$_state" ]; then
    _state="$(read_first_line "${ARGVUS_CONFIG_HOME}/argvus/state/effects" "")"
  fi
  case "$_state" in
    enabled) return 0 ;;
    disabled) return 1 ;;
  esac

  # Keep the implicit default identical to effects-toggle.sh. In particular,
  # VMs start with transparency disabled even before a user explicitly toggles the
  # setting, so terminal backgrounds must not retain theme transparency.
  [ "${ARGVUS_LOW_POWER:-0}" = 1 ] && return 1
  if command -v systemd-detect-virt >/dev/null 2>&1 \
    && systemd-detect-virt --vm >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

theme_default_accent() {
  case "$1" in
    argvus-onedark|argvus-onedark-float) printf '#61AFEF\n' ;;
    argvus-dark-dracula|argvus-dark-dracula-float) printf '#BD93F9\n' ;;
    argvus-dark-aether|argvus-dark-aether-float) printf '#3590bd\n' ;;
    argvus-dark-silver|argvus-dark-silver-float) printf '#595959\n' ;;
    argvus-light-veil|argvus-light-veil-float) printf '#181818\n' ;;
    argvus-github-light|argvus-github-light-float) printf '#0969DA\n' ;;
    argvus-light-solarized|argvus-light-solarized-float) printf '#268BD2\n' ;;
    argvus-light-frost|argvus-light-frost-float) printf '#0969DA\n' ;;
    argvus-dark-slate|argvus-dark-slate-float) printf '#7391a5\n' ;;
    argvus-dark-universe|argvus-dark-universe-float) printf '#eeeeee\n' ;;
    argvus-dark-gruvbox-high|argvus-dark-gruvbox-high-float) printf '#D79921\n' ;;
    argvus-dark-gruvbox|argvus-dark-gruvbox-float) printf '#D4BE98\n' ;;
    argvus-dark-tokio-night|argvus-dark-tokio-night-float) printf '#7AA2F7\n' ;;
    argvus-dark-solitude|argvus-dark-solitude-float) printf '#798186\n' ;;
    argvus-dark-sunset|argvus-dark-sunset-float) printf '#E2BE8A\n' ;;
    argvus-dark-hackerman|argvus-dark-hackerman-float) printf '#82FB9C\n' ;;
    *) printf '%s\n' "$DEFAULT_ACCENT" ;;
  esac
}

read_accent() {
  _theme="$1"
  _fallback="$(theme_default_accent "$_theme")"
  read_first_line "${ARGVUS_CONFIG_HOME}/argvus/.accent-color" "$_fallback"
}

font_state_value() {
  _key="$1"
  _fallback="$2"
  _fonts_file="${ARGVUS_CONFIG_HOME}/argvus/fonts.conf"
  if [ -f "$_fonts_file" ]; then
    _value="$(sed -n "s|^${_key}=||p" "$_fonts_file" | head -n1)"
    [ -n "$_value" ] && { printf '%s\n' "$_value"; return 0; }
  fi
  printf '%s\n' "$_fallback"
}

font_family() {
  case "$1" in
    apps) font_state_value apps_family "$(font_state_value default_family "IBM Plex Mono")" ;;
    *) font_state_value terminal_family "$(font_state_value monospace_family "IBM Plex Mono")" ;;
  esac
}

font_size() {
  case "$1" in
    apps) font_state_value apps_size "$(font_state_value default_size 12)" ;;
    *) font_state_value terminal_size "$(font_state_value monospace_size 13)" ;;
  esac
}

theme_file() {
  _theme="$1"
  for _file in \
    "${ARGVUS_CONFIG_HOME}/argvus/terminal/kitty/themes/${_theme}/theme.conf" \
    "${SYSTEM_ROOT}/config/themes/${_theme}/theme.conf"; do
    [ -f "$_file" ] && { printf '%s\n' "$_file"; return 0; }
  done
  printf '%s\n' "${SYSTEM_ROOT}/config/themes/${DEFAULT_THEME}/theme.conf"
}

base_config() {
  for _file in \
    "${ARGVUS_CONFIG_HOME}/argvus/terminal/kitty/kitty.conf" \
    "${SYSTEM_ROOT}/config/kitty.conf"; do
    [ -f "$_file" ] && { printf '%s\n' "$_file"; return 0; }
  done
  die "$(argvus_tr terminal config_not_found path="${SYSTEM_ROOT}/config")"
}

tui_config() {
  for _file in \
    "${ARGVUS_CONFIG_HOME}/argvus/terminal/kitty-tui/kitty.conf" \
    "${SYSTEM_ROOT}/config/kitty-tui/kitty.conf"; do
    [ -f "$_file" ] && { printf '%s\n' "$_file"; return 0; }
  done
  die "$(argvus_tr terminal tui_config_not_found path="${SYSTEM_ROOT}/config/kitty-tui")"
}

runtime_base_config() {
  _theme="${1:-$(read_active_theme)}"
  _profile="${2:-terminal}"
  _src="$(base_config)"
  case "$_profile" in
    terminal) _dst="$(paths_cache argvus-terminal/kitty.conf)" ;;
    *) _dst="$(paths_cache "argvus-terminal/kitty-${_profile}.conf")" ;;
  esac
  _theme_file="$(theme_file "$_theme")"
  _family="$(font_family "$_profile")"
  _size="$(font_size "$_profile")"
  _accent="$(read_accent "$_theme")"
  _effects_opacity="1.0"
  if transparency_enabled; then
    _effects_opacity=""
  fi

  mkdir -p "${_dst%/*}"
  _tmp="$(mktemp "${_dst}.XXXXXX")" || die "$(argvus_tr terminal cache_create_failed path="${_dst}")"
  if ! awk \
    -v theme_file="$_theme_file" \
    -v family="$_family" \
    -v size="${_size}.0" \
    -v accent="$_accent" \
    -v opacity="$_effects_opacity" '
      # The canonical package path is terminal/config/themes. Keep this
      # independent of the old Kitty-specific directory name so --apply
      # really replaces the theme in every generated Kitty profile.
      /^[[:space:]]*include[[:space:]].*\/themes\/[^[:space:]]+\/theme\.conf[[:space:]]*$/ { print "include " theme_file; next }
      /^[[:space:]]*font_family[[:space:]]+/ { print "font_family      " family; next }
      /^[[:space:]]*font_size[[:space:]]+/ { print "font_size        " size; next }
      /^[[:space:]]*background_opacity[[:space:]]+/ {
        if (opacity != "") print "background_opacity " opacity
        else print
        next
      }
      { print }
      END {
        # Theme files are included above and their background_opacity setting
        # takes effect after the base configuration has been parsed. Emit the
        # disabled-transparency override last so Kitty and argvus-terminal always
        # get an opaque surface.
        if (opacity != "") print "background_opacity " opacity
        print ""
        print "# Runtime ARGVUS accent override"
        print "active_tab_foreground   " accent
      }
    ' "$_src" > "$_tmp"; then
    rm -f -- "$_tmp"
    die "$(argvus_tr terminal cache_write_failed path="${_dst}")"
  fi
  [ -s "$_tmp" ] || {
    rm -f -- "$_tmp"
    die "$(argvus_tr terminal cache_write_failed path="${_dst}")"
  }
  mv -f -- "$_tmp" "$_dst"
  printf '%s\n' "$_dst"
}

runtime_tui_config() {
  _theme="${1:-$(read_active_theme)}"
  _profile="${2:-terminal}"
  _src="$(tui_config)"
  _base="$(runtime_base_config "$_theme" "$_profile")"
  case "$_profile" in
    terminal) _dst="$(paths_cache argvus-terminal/kitty-tui.conf)" ;;
    *) _dst="$(paths_cache "argvus-terminal/kitty-tui-${_profile}.conf")" ;;
  esac
  _family="$(font_family "$_profile")"
  _size="$(font_size "$_profile")"

  mkdir -p "${_dst%/*}"
  _tmp="$(mktemp "${_dst}.XXXXXX")" || die "$(argvus_tr terminal cache_create_failed path="${_dst}")"
  if ! awk \
    -v base="$_base" \
    -v family="$_family" \
    -v size="${_size}.0" '
      /^[[:space:]]*include[[:space:]]+/ { print "include " base; next }
      /^[[:space:]]*font_family[[:space:]]+/ { print "font_family      " family; next }
      /^[[:space:]]*font_size[[:space:]]+/ { print "font_size        " size; next }
      { print }
    ' "$_src" > "$_tmp"; then
    rm -f -- "$_tmp"
    die "$(argvus_tr terminal cache_write_failed path="${_dst}")"
  fi
  [ -s "$_tmp" ] || {
    rm -f -- "$_tmp"
    die "$(argvus_tr terminal cache_write_failed path="${_dst}")"
  }
  mv -f -- "$_tmp" "$_dst"
  printf '%s\n' "$_dst"
}

cache_lock_acquire() {
  _lock="$(paths_cache argvus-terminal.lock)"
  mkdir -p "${_lock%/*}"
  # Serialize --apply with normal terminal launches. Kitty never inherits
  # the descriptor because it is released before exec.
  exec 9>"$_lock"
  flock --exclusive 9 || die "$(argvus_tr terminal cache_lock_failed path="${_lock}")"
}

cache_lock_release() {
  flock --unlock 9 2>/dev/null || true
  exec 9>&-
}

mode="launch"
theme=""
class="kitty"
font_profile="terminal"
use_tui=0

case "${1:-}" in
  --help|-h)
    usage
    exit 0
    ;;
  --apply)
    mode="apply"
    shift
    theme="${1:-}"
    ;;
  --print-config)
    mode="print-config"
    shift
    theme="${1:-}"
    ;;
  --print-tui-config)
    mode="print-tui-config"
    shift
    theme="${1:-}"
    ;;
esac

if [ "$mode" = "apply" ]; then
  theme="${theme:-$(read_active_theme)}"
  cache_lock_acquire
  runtime_base_config "$theme" terminal >/dev/null
  runtime_tui_config "$theme" terminal >/dev/null
  runtime_tui_config "$theme" apps >/dev/null
  cache_lock_release
  exit 0
fi

if [ "$mode" = "print-config" ]; then
  cache_lock_acquire
  runtime_base_config "${theme:-$(read_active_theme)}" "$font_profile"
  cache_lock_release
  exit 0
fi

if [ "$mode" = "print-tui-config" ]; then
  cache_lock_acquire
  runtime_tui_config "${theme:-$(read_active_theme)}" "$font_profile"
  cache_lock_release
  exit 0
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --class)
      [ "$#" -ge 2 ] || die "$(argvus_tr terminal class_requires_value)"
      class="$2"
      shift 2
      ;;
    --class=*)
      class="${1#--class=}"
      shift
      ;;
    --font-profile)
      [ "$#" -ge 2 ] || die "$(argvus_tr terminal font_profile_requires_value)"
      font_profile="$2"
      shift 2
      ;;
    --font-profile=*)
      font_profile="${1#--font-profile=}"
      shift
      ;;
    --tui)
      use_tui=1
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

case "$font_profile" in
  terminal|apps) ;;
  *) die "$(argvus_tr terminal unsupported_font_profile profile="$font_profile")" ;;
esac

command -v kitty >/dev/null 2>&1 || die "$(argvus_tr terminal kitty_not_installed)"

if [ "$use_tui" -eq 1 ]; then
  cache_lock_acquire
  config="$(runtime_tui_config "$(read_active_theme)" "$font_profile")"
else
  cache_lock_acquire
  config="$(runtime_base_config "$(read_active_theme)" "$font_profile")"
fi

cache_lock_release
exec kitty --class "$class" --config "$config" "$@"
